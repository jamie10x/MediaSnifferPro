{
  "name": "media-sniffer-pro",
  "version": "1.0.0",
  "description": "Detect and download media files available on the current page.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
